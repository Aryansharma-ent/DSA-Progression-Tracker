## Basic Template

```cpp
vector<pair<int, int>> events;

for (auto& interval : intervals) {
    int l = interval[0];
    int r = interval[1];

    events.push_back({l, +1});
    events.push_back({r + 1, -1});
}

sort(events.begin(), events.end());

int active = 0;

for (auto& [pos, delta] : events) {
    active += delta;
}
```

---

## Maximum Overlap Template

```cpp
vector<pair<int, int>> events;

for (auto& interval : intervals) {
    int l = interval[0];
    int r = interval[1];

    events.push_back({l, +1});
    events.push_back({r + 1, -1});
}

sort(events.begin(), events.end());

int active = 0;
int answer = 0;

for (auto& [pos, delta] : events) {
    active += delta;
    answer = max(answer, active);
}
```

